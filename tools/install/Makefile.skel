# ==================== Makefile for AtChem2 ==================== #

# Choose fortran compiler:
# 1. 'gnu' for gfortran (DEFAULT)
# 2. 'intel' for ifx or ifort
FORTC = gnu

# Choose intel compiler, if not using GNU:
# 1. ifort (DEPRECATED)
# 2. ifx
INTELC = ifx

# Set the dependencies paths. Use full paths, not relative paths.
# For example: $(HOME)/path/to/dependencies/directory/cvode/lib
CVODELIBDIR = cvode/lib
OPENLIBMDIR = openlibm
FRUITDIR    = fruit_3.4.3

# =========================================================================== #
#                       DO NOT MODIFY BELOW THIS LINE
# =========================================================================== #

.SUFFIXES:
.SUFFIXES: .f90 .o # TODO: is this needed?
.PHONY: all sharedlib check clean

# remove a target if its recipe fails
.DELETE_ON_ERROR:

# detect operating system
OS := $(shell uname -s)

# on GitHub Actions, set the fortran compiler
ifeq ($(GITHUB_ACTIONS),true)
  ifeq ($(RUNNER_OS),Linux)
    # on Linux, pass gfortran
    FORT_COMP = gfortran-$(FORT_VERSION)
  else
    # on macOS, pass homebrew gfortran
    FORT_COMP = /usr/local/bin/gfortran-$(FORT_VERSION)
  endif
# set the fortran compiler
else
  ifeq ($(FORTC),gnu)
    FORT_COMP = gfortran
  else ifeq ($(FORTC),intel)
    FORT_COMP = $(INTELC)
  else
    $(error Invalid fortran compiler. Set FORTC to 'gnu' or 'intel'.)
  endif
endif

# set the compilation flags for each compiler:
#
# - FF_SOURCE: free-form source, no implicit typing
# - FF_WARN: compiler warnings, including a check for non-standard fortran
# - FF_CHECK: run-time checks
# - FF_PIC: position-independent code (needed by the shared library)
# - FF_OPT: optimization (executable and shared library)
# - FF_SHARED: build a shared library with additional flags (no limit to the length
#              of the source line; suppress warning for unused dummy arguments)
# - FF_COV: code coverage testing (gnu only)
CCOV = false
ifeq ($(FORTC),gnu)
  FF_SOURCE   = -ffree-form -fimplicit-none
  FF_WARN     = -Wall -Wpedantic
  FF_CHECK    = -fcheck=all
  FF_PIC      = -fPIC
  FF_OPT      = -O2
  FF_SHARED   = -shared -ffree-line-length-none -Wno-unused-dummy-argument
  FF_COV      = -fprofile-arcs -ftest-coverage
endif
ifeq ($(FORTC),intel)
  FF_SOURCE   = -free -implicitnone
  FF_WARN     = -warn all -stand
  FF_CHECK    = -check all
  FF_PIC      = -fpic
  FF_OPT      = -O2
  FF_SHARED   = -shared
  FF_COV      =
endif

# flags for the executable: add `gcov` flags for code coverage testing, otherwise
# add the optimization flag for normal usage
FFLAGS = $(FF_SOURCE) $(FF_WARN) $(FF_CHECK) $(FF_PIC)
ifeq ($(CCOV),true)
  ifeq ($(FORTC),gnu)
    FFLAGS += $(FF_COV)
  else
    FFLAGS += $(FF_OPT)
    $(warning Code coverage testing is only available for the 'gnu' compiler.)
  endif
else
  FFLAGS += $(FF_OPT)
endif

# flags for the chemical mechanism shared library
FSHAREDFLAGS = $(FF_SOURCE) $(FF_WARN) $(FF_CHECK) $(FF_PIC) $(FF_OPT) $(FF_SHARED)

# set the rpath flag
ifeq ($(OS),Linux)
  RPATH_OPTION = -R
else
  RPATH_OPTION = -rpath
endif

# set the CVODE and openlibm compilation flags
LDFLAGS = -L$(CVODELIBDIR) -L$(OPENLIBMDIR) \
          -Wl,$(RPATH_OPTION),/usr/lib/:$(CVODELIBDIR):$(OPENLIBMDIR) \
          -lopenlibm -lsundials_fcvode -lsundials_cvode -lsundials_fnvecserial \
          -lsundials_nvecserial -ldl

# ----------------------------------------------------
# EXECUTABLE setup

# directories for the fortran source and object/module files
SRC = src
OBJ = obj

# atchem executable
AOUT = atchem2

# fortran source files
CORE_SRCS = $(SRC)/dataStructures.f90 $(SRC)/configFunctions.f90 \
            $(SRC)/atmosphereFunctions.f90 $(SRC)/solarFunctions.f90 \
            $(SRC)/interpolationFunctions.f90 $(SRC)/constraintFunctions.f90 \
            $(SRC)/inputFunctions.f90 $(SRC)/outputFunctions.f90 \
            $(SRC)/parameterModules.f90 $(SRC)/solverFunctions.f90 \
            $(SRC)/argparse.f90
SRCS = $(CORE_SRCS) $(SRC)/atchem2.f90

# the executable is rebuilt every time one of the fortran files (in $SRCS)
# is modified
$(AOUT): $(SRCS)
	$(FORT_COMP) -o $(AOUT) -J$(OBJ) -I$(OBJ) $(SRCS) $(FFLAGS) $(LDFLAGS)

# secondary makefile for the Testsuite
-include tests/Makefile

# ----------------------------------------------------
# MECHANISM SHARED LIBRARY setup

# Default settings:
# - the chemical mechanism file is: model/mechanism.fac
# - the configuration files are in: model/configuration
# - the mechanism fortran files are in: model/sharedlib
# - the mechanism shared library is: model/sharedlib/mechanism.so
# - the MCM version is: v3.3.1
MECHFILE = model/mechanism.fac
CONFIGDIR = model/configuration
SHAREDLIBDIR = model/sharedlib
SHAREDLIB = $(SHAREDLIBDIR)/mechanism.so
MCM_VERS = v3.3.1

# mechanism conversion script
MECH_CONVERTER = build/mech_converter.py

# use Python v3 unless overridden by the build script
PYTHON_BIN = python3

# the mechanism shared library is rebuilt every time the chemical mechanism file
# ($MECHFILE), `customRateFuncs.f90` (in $CONFIGDIR) or `dataStructures.f90` are
# modified. The conversion script generates the fortran files `mechanism.*` in
# $SHAREDLIBDIR, which are then compiled into the mechanism shared library `mechanism.so`
$(SHAREDLIB): $(MECHFILE) $(CONFIGDIR)/customRateFuncs.f90 $(SRC)/dataStructures.f90
	$(PYTHON_BIN) $(MECH_CONVERTER) $(MECHFILE) $(CONFIGDIR) $(SHAREDLIBDIR) $(MCM_VERS)
	$(FORT_COMP) -c $(SRC)/dataStructures.f90 $(FSHAREDFLAGS) -o $(SHAREDLIBDIR)/dataStructures.o -J$(SHAREDLIBDIR) -I$(SHAREDLIBDIR)
	$(FORT_COMP) -c $(CONFIGDIR)/customRateFuncs.f90 $(FSHAREDFLAGS) -o $(SHAREDLIBDIR)/customRateFuncs.o -J$(SHAREDLIBDIR) -I$(SHAREDLIBDIR)
	$(FORT_COMP) -c $(SHAREDLIBDIR)/mechanism.f90 $(FSHAREDFLAGS) -o $(SHAREDLIBDIR)/mechanism.o -J$(SHAREDLIBDIR) -I$(SHAREDLIBDIR)
	$(FORT_COMP) -shared -o $(SHAREDLIB) $(SHAREDLIBDIR)/dataStructures.o $(SHAREDLIBDIR)/customRateFuncs.o $(SHAREDLIBDIR)/mechanism.o

# ----------------------------------------------------
# CLEANUP list

CLEAN_EXEC  = $(AOUT)
CLEAN_BUILD = $(addprefix *, .gcda .gcno .xml) $(OBJ)/*
CLEAN_MECH  = $(SHAREDLIBDIR)/*
CLEAN_PY    = build/*.pyc
CLEAN_DOC   = $(addprefix doc/latex/*, .aux .bbl .blg .log .out .toc) \
              $(addprefix doc/figures/*, .png)
CLEAN_OUT   = $(addprefix model/output/*, .output .pdf) model/output/reactionRates/*[0-9]

# ====================== Makefile rules ====================== #

all: $(AOUT)

sharedlib: $(SHAREDLIB)

check:
	@status=0; \
	for lib in "$(CVODELIBDIR)/libsundials_cvode" "$(OPENLIBMDIR)/libopenlibm"; do \
	  if ! ls "$$lib".* >/dev/null 2>&1; then \
	    echo "[error] library not found: $$lib.* (set CVODELIBDIR and OPENLIBMDIR in the Makefile)"; \
	    status=1; \
	  fi; \
	done; \
	exit $$status

clean:
	rm -f $(CLEAN_EXEC) $(CLEAN_BUILD) $(CLEAN_MECH) $(CLEAN_PY) $(CLEAN_DOC) $(CLEAN_OUT)
	rm -rf build/__pycache__

# ==================== Dependencies ==================== #

atchem2.o : atchem2.f90 inputFunctions.o configFunctions.o dataStructures.o
argparse.o : argparse.f90 dataStructures.o
constraintFunctions.o : constraintFunctions.f90 dataStructures.o
atmosphereFunctions.o : atmosphereFunctions.f90
dataStructures.o : dataStructures.f90
inputFunctions.o : inputFunctions.f90 configFunctions.o dataStructures.o
interpolationFunctions.o : interpolationFunctions.f90 dataStructures.o
configFunctions.o : configFunctions.f90
outputFunctions.o : outputFunctions.f90 dataStructures.o
parameterModules.o : parameterModules.f90 dataStructures.o
solverFunctions.o : solverFunctions.f90 dataStructures.o
